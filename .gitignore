# ════════════════════════════════════════════════════════════════
#  기밀 — 클라이언트 프로젝트 데이터: 공개 repo에 절대 포함 금지
#  (projects/<project-id> = 실제 발주처 제안서 원본 · client_notes 등)
# ════════════════════════════════════════════════════════════════
projects/
archive/

# ════════════════════════════════════════════════════════════════
#  Vendored 외부 오픈소스 — 별도 라이선스, upstream 추적용 (push 금지)
#  재설치: gh repo clone hugohe3/ppt-master vendor/ppt-master
# ════════════════════════════════════════════════════════════════
vendor/ppt-master/

# ════════════════════════════════════════════════════════════════
#  산출물 원본 형식 — 실데이터 포함 가능 (defense-in-depth)
#  단, templates/ 아래의 공개용 빈 템플릿은 예외로 포함 허용
# ════════════════════════════════════════════════════════════════
*.pptx
*.pdf
*.hwp
*.hwpx
!templates/**/*.pptx
!templates/**/*.hwp

# ════════════════════════════════════════════════════════════════
#  표준
# ════════════════════════════════════════════════════════════════
__pycache__/
*.pyc
.DS_Store
.venv/
node_modules/
_portfolio_export/
_demo_output/
